# Enterprise BI Engine - local runtime configuration
# Copy to .env and fill in. NEVER commit .env.

# Required for a live LLM debate. Without it the app runs in
# Deterministic Replay mode (all SQL/statistics still execute for real).
OPENAI_API_KEY=

# Model used for the AutoGen agents.
OPENAI_MODEL=gpt-4o-mini

# Telemetry cost assumptions, USD per 1,000,000 tokens.
# Defaults below correspond to gpt-4o-mini list pricing.
COST_PER_MTOK_INPUT=0.150
COST_PER_MTOK_OUTPUT=0.600

# Local Neo4j for the HITL persistent memory graph.
# If unreachable, feedback falls back to a local JSONL journal.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
